# Database
# Note: When running locally with Docker Compose, the database host is the container name (e.g., internflow-db)
DATABASE_URL="postgresql://postgres:postgres@internflow-db:5432/internflow?schema=public"

# Auth
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"

# Server
PORT=4000

# Teerayut: use its own database to keep the Project submission independent.
# DATABASE_URL="postgresql://internflow:password@localhost:5432/internflow_teerayut?schema=public"

# Account email: real SMTP in production. Mailpit captures local test email only.
FRONTEND_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="InternFlow <noreply@internflow.local>"
# SMTP_USER=
# SMTP_PASSWORD=

# AI (server-side only; never use a VITE_ key)
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=

# AWS S3 Configuration (Optional for local development, required for production)
# AWS_REGION="ap-southeast-1"
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# S3_BUCKET_NAME="internflow-bucket"
