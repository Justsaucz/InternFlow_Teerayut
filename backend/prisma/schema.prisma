generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  COMPANY_HR
  UNIVERSITY_ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW_SCHEDULED
  ACCEPTED
  COMMITTED
  CANCEL_REQUESTED
  CANCELLED
  REJECTED
  APPROVED_BY_UNIVERSITY
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  companyProfile CompanyProfile?
  documents      Document[]
  passwordVersion Int @default(0)
  emailVerifiedAt DateTime?
  emailVerificationRequired Boolean @default(false)
  accountTokens AccountToken[]
  notifications Notification[]
  readinessConfirmations ReadinessConfirmation[]
}


model StudentProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  
  studentId    String   @default("")
  major        String   @default("")
  faculty      String   @default("")
  university   String?  @default("")
  year         Int      @default(1)
  gpa          Float?
  skills       String[]
  bio          String?
  avatarUrl    String?
  
  applications Application[]
  weeklyLogs   WeeklyLog[]
  dailyLogs    DailyLog[]
  evaluations  InternshipEvaluation[]
}

model CompanyProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  
  companyName  String
  industry     String
  website      String?
  description  String?
  logoUrl      String?
  address      String?
  contactEmail String?
  contactPhone String?
  
  jobPosts     JobPost[]
  evaluations  InternshipEvaluation[]
}

model JobPost {
  id               String         @id @default(uuid())
  companyProfileId String
  company          CompanyProfile @relation(fields: [companyProfileId], references: [id])
  
  title            String
  description      String
  requirements     String
  location         String
  isRemote         Boolean        @default(false)
  positions        Int            @default(1)
  allowance        String?
  workingHours     String?
  contactEmail     String?
  contactPhone     String?
  contactLine      String?
  applicationLink  String?
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean        @default(true)
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  applications     Application[]
  screeningTemplate ScreeningTemplate?
  readinessEnabled Boolean @default(false)
  readinessDeadline DateTime?
  readinessVersion Int @default(0)

  @@index([readinessEnabled, readinessDeadline])
}

model Application {
  id             String            @id @default(uuid())
  jobPostId      String
  jobPost        JobPost           @relation(fields: [jobPostId], references: [id])
  studentId      String
  student        StudentProfile    @relation(fields: [studentId], references: [id])
  
  status             ApplicationStatus @default(PENDING)
  // Individual start dates and confirmation deadlines; job-level fields are legacy only.
  readinessEnabled   Boolean @default(false)
  readinessStartDate DateTime?
  readinessDeadline  DateTime?
  readinessVersion   Int @default(0)
  coverLetter        String?
  cancellationReason String?
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  documents      Document[]
  weeklyLogs     WeeklyLog[]
  dailyLogs      DailyLog[]
  evaluation     InternshipEvaluation?
  evidenceEntries EvidenceEntry[]
  screeningAssessment ScreeningAssessment?
  portfolioReviews PortfolioReview[]
  readinessConfirmations ReadinessConfirmation[]
  readinessNotices ReadinessNotice[]

  @@index([jobPostId, status])

  @@unique([studentId, jobPostId])
  @@index([readinessEnabled, readinessDeadline])
}

model Document {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  
  title         String
  fileUrl       String
  type          String       // e.g., "CV", "TRANSCRIPT", "REPORT"
  mimeType String?
  byteSize Int?
  evidenceEntries EvidenceEntry[]
  
  createdAt     DateTime     @default(now())
}

model WeeklyLog {
  id                   String         @id @default(uuid())
  studentId            String
  student              StudentProfile @relation(fields: [studentId], references: [id])
  applicationId        String?
  application          Application?   @relation(fields: [applicationId], references: [id])
  
  weekNumber           Int
  startDate            DateTime
  endDate              DateTime
  workModality         String         @default("ON_SITE")
  supervisorName       String?
  plannedTasks         String?
  tasksDone            String
  problemsAndSolutions String?
  learnings            String
  hoursWorked          Float          @default(40.0)
  attachmentUrl        String?
  
  mentorApproved       Boolean        @default(false)
  mentorRating         Int?
  mentorFeedback       String?
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model DailyLog {
  id                   String         @id @default(uuid())
  studentId            String
  student              StudentProfile @relation(fields: [studentId], references: [id])
  applicationId        String?
  application          Application?   @relation(fields: [applicationId], references: [id])
  
  logDate              DateTime
  weekNumber           Int            @default(1)
  hoursWorked          Float          @default(8.0)
  workModality         String         @default("ON_SITE") // ON_SITE, REMOTE, HYBRID
  supervisorName       String?
  tasksDone            String         // JSON string of task items
  problemsAndSolutions String?
  learnings            String
  attachmentUrl        String?
  
  isBackdated          Boolean        @default(false)
  
  // Company Sign-off (Can be approved per-day or batch-approved per-week)
  mentorApproved       Boolean        @default(false)
  mentorRating         Int?           // 1-5 stars
  mentorFeedback       String?
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([studentId, logDate])
}

enum EvaluationStatus {
  PENDING_REVIEW
  COMPANY_EVALUATED
  GRADED
}

model InternshipEvaluation {
  id                 String           @id @default(uuid())
  studentId          String
  student            StudentProfile   @relation(fields: [studentId], references: [id])
  companyId          String
  company            CompanyProfile   @relation(fields: [companyId], references: [id])
  applicationId      String?          @unique
  application        Application?     @relation(fields: [applicationId], references: [id])
  
  workQualityScore   Int              @default(5)
  punctualityScore   Int              @default(5)
  teamworkScore      Int              @default(5)
  feedback           String
  
  status             EvaluationStatus @default(COMPANY_EVALUATED)
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model AccountToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose])
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  title String
  message String
  href String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model EvidenceEntry {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  projectKey String
  previousId String? @unique
  version Int @default(1)
  title String
  summary String
  contribution String
  skills String[]
  evidenceDate DateTime
  linkUrl String?
  documentId String?
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fileSha256 String?
  aiConsent Boolean @default(false)
  createdBy String
  createdAt DateTime @default(now())
  @@unique([applicationId, projectKey, version])
  @@index([applicationId, createdAt])
}

model ApplicationPreparation {
  id String @id @default(uuid())
  userId String
  jobPostId String
  documentIds String[]
  hashes Json
  report Json
  contribution String
  skills String
  model String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model ScreeningTemplate {
  onApply Boolean @default(false)
  id String @id @default(uuid())
  jobPostId String @unique
  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  title String
  questions Json
  version Int @default(1)
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScreeningAssessment {
  id String @id @default(uuid())
  applicationId String @unique
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title String
  templateVersion Int
  questions Json
  answers Json?
  status String @default("ASSIGNED")
  assignedBy String
  dueAt DateTime
  submittedAt DateTime?
  review Json?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
}

model PortfolioReview {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  source String
  model String?
  report Json
  evidenceSnapshot Json
  createdBy String
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
}

model ReadinessConfirmation {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  scheduleVersion Int
  source String
  confirmedById String
  confirmedBy User @relation(fields:[confirmedById], references:[id])
  confirmedAt DateTime @default(now())
  @@unique([applicationId, scheduleVersion])
}
model ReadinessNotice {
  id String @id @default(uuid())
  applicationId String
  application Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  scheduleVersion Int
  kind String
  createdAt DateTime @default(now())
  @@unique([applicationId, scheduleVersion, kind])
}
